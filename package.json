    "@types/node": "^20.14.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.6",
    "typescript": "^5.5.4",
    "wrangler": "^4.142.0"
  }
